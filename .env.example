# Frontend (Vite exposes VITE_ prefixed vars to the browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key
VITE_API_URL=http://localhost:8080

# Backend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role-key
GOOGLE_AI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# REWE API (mTLS certificates extracted from REWE Android APK)
# Local dev: point to your PEM files on disk
# Cloud Run: mounted from Secret Manager at /secrets/rewe-{cert,key}/latest
REWE_CERT_PATH=
REWE_KEY_PATH=

# CORS (pipe-separated origins)
ALLOWED_ORIGINS=http://localhost:5173|http://localhost:4173
